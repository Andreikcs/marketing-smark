{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "Grupo Smark Design System",
  "version": "2.1.0",
  "_doc": "Tokens portáveis do sistema visual do Grupo Smark. Espelha design-system/tokens/tokens.json (fonte da verdade no vault) no formato que outro projeto consome. Tema padrão = claro.",

  "meta": {
    "temaPadrao": "claro",
    "regraAcento": "O acento colore a PALAVRA-chave, nunca um bloco/caixa inteira.",
    "ritmoFeed": { "claro": "~70%", "escuro": "~30%" }
  },

  "tipografia": {
    "fontes": {
      "display": "'Anton', sans-serif",
      "texto": "'Archivo', system-ui, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, monospace"
    },
    "importGoogleFonts": "https://fonts.googleapis.com/css2?family=Anton&family=Archivo:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500&display=swap",
    "escala": {
      "h1":     { "fonte": "display", "tamanho": "56px", "entrelinha": "0.94", "caixa": "alta" },
      "h2":     { "fonte": "display", "tamanho": "40px", "entrelinha": "1",    "caixa": "alta" },
      "kicker": { "fonte": "texto", "tamanho": "12px", "peso": 700, "tracking": "0.16em", "caixa": "alta", "cor": "accent" },
      "lead":   { "fonte": "texto", "tamanho": "19px", "entrelinha": "1.55", "cor": "sub" },
      "corpo":  { "fonte": "texto", "tamanho": "15px", "entrelinha": "1.5" },
      "meta":   { "fonte": "texto", "tamanho": "13px", "cor": "muted" }
    },
    "_regra": "Anton é SEMPRE caixa-alta com entrelinha apertada. Archivo carrega todo o texto corrido."
  },

  "raio": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "pill": "999px"
  },

  "espaco": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px",
    "6": "24px", "8": "32px", "12": "48px", "16": "64px"
  },

  "temas": {
    "claro": {
      "_papel": "PADRÃO. Vitrine pública, marketing, telas de leitura.",
      "bg": "#F4F2FB",
      "surface": "#FFFFFF",
      "surface-2": "#FAF8FE",
      "inset": "#F3F0FB",
      "text": "#100D1C",
      "sub": "#4A4560",
      "muted": "#6B6680",
      "line": "rgba(16,13,28,.10)",
      "line-strong": "rgba(16,13,28,.16)",
      "field": "#FFFFFF",
      "field-line": "rgba(16,13,28,.18)",
      "accent": "#8B3CF7",
      "accent-2": "#A472FF",
      "accent-soft": "#EFE7FF",
      "accent-ink": "#FFFFFF",
      "lime": "#C6F24E",
      "lime-ink": "#2A2E12",
      "lime-soft": "#EEF9CF",
      "good": "#1F8A5B",
      "good-soft": "#DFF3E9",
      "warn": "#B0741A",
      "warn-soft": "#FAEFD8",
      "bad": "#C4453B",
      "bad-soft": "#FAE3E1",
      "info": "#2A6FDB",
      "info-soft": "#E1ECFB",
      "shadow": "0 1px 2px rgba(16,13,28,.05),0 10px 26px rgba(16,13,28,.06)",
      "shadow-lg": "0 24px 64px rgba(16,13,28,.16)"
    },
    "escuro": {
      "_papel": "SECUNDÁRIO. UI de produto, painéis de trabalho, contraponto no feed.",
      "bg": "#14141A",
      "surface": "#1E1E26",
      "surface-2": "#26262F",
      "inset": "#191920",
      "text": "#F2F0F7",
      "sub": "#B8B5C4",
      "muted": "#918E9E",
      "line": "rgba(255,255,255,.12)",
      "line-strong": "rgba(255,255,255,.20)",
      "field": "#1A1A22",
      "field-line": "rgba(255,255,255,.18)",
      "accent": "#B18BFF",
      "accent-2": "#9A6AFF",
      "accent-soft": "rgba(177,139,255,.22)",
      "accent-ink": "#12081F",
      "lime": "#C6F24E",
      "lime-ink": "#1A1E08",
      "lime-soft": "rgba(198,242,78,.14)",
      "good": "#4DDB9A",
      "good-soft": "rgba(77,219,154,.16)",
      "warn": "#EBC06A",
      "warn-soft": "rgba(235,192,106,.16)",
      "bad": "#F28B82",
      "bad-soft": "rgba(242,139,130,.16)",
      "info": "#7AB0FF",
      "info-soft": "rgba(122,176,255,.16)",
      "shadow": "0 1px 2px rgba(0,0,0,.28),0 12px 28px rgba(0,0,0,.32)",
      "shadow-lg": "0 24px 56px rgba(0,0,0,.42)"
    }
  },

  "marcas": {
    "_doc": "O sistema é um só; a marca troca apenas o acento, o gradiente e a assinatura. Produtos assinam 'uma plataforma smark.'",
    "smark": {
      "nome": "smark.",
      "papel": "marca-mãe",
      "acento": "#8B3CF7",
      "acentoClaro": "#A472FF",
      "acentoSecundario": "#C6F24E",
      "gradiente": "linear-gradient(155deg,#8B3CF7 0%,#050D1A 100%)",
      "baseEscura": "#050D1A",
      "glyph": "S",
      "simboloPath": "M50 7 L86 90 L50 58 L14 90 Z M41 46 a9 9 0 1 0 18 0 a9 9 0 1 0 -18 0 Z",
      "simboloViewBox": "0 0 100 100",
      "simboloFillRule": "evenodd",
      "handle": "@smark",
      "endossa": false
    },
    "provider-max": {
      "nome": "Provider Max",
      "papel": "produto · ISPs",
      "acento": "#8B3CF7",
      "acentoClaro": "#A472FF",
      "gradiente": "linear-gradient(155deg,#9A4DFF 0%,#2A1CA8 100%)",
      "baseEscura": "#2A1CA8",
      "glyph": "P",
      "wordmark": "Provider *Max*",
      "simboloSvg": "<circle cx='50' cy='71' r='7' fill='currentColor'/><path d='M37 61 Q50 46 63 61' stroke='currentColor' stroke-width='9' fill='none' stroke-linecap='round'/><path d='M27 52 Q50 27 73 52' stroke='currentColor' stroke-width='9' fill='none' stroke-linecap='round'/><path d='M17 43 Q50 10 83 43' stroke='currentColor' stroke-width='9' fill='none' stroke-linecap='round'/>",
      "handle": "@providermax",
      "endossa": true
    },
    "elever-ai": {
      "nome": "Elever AI",
      "papel": "produto · pré-vendas",
      "acento": "#8B3CF7",
      "acentoClaro": "#A472FF",
      "gradiente": "linear-gradient(155deg,#9A4DFF 0%,#2A1CA8 100%)",
      "baseEscura": "#2A1CA8",
      "glyph": "E",
      "wordmark": "Elever *AI*",
      "simboloPath": "M50 4 C54 34 66 46 96 50 C66 54 54 66 50 96 C46 66 34 54 4 50 C34 46 46 34 50 4 Z",
      "simboloViewBox": "0 0 100 100",
      "handle": "@eleverai",
      "endossa": true
    }
  },

  "regras": [
    "Acento é palavra, nunca bloco. Roxo colore a palavra-chave — não pinte caixas inteiras.",
    "Um primário por tela. Só um botão roxo cheio por vista; o resto é secundário ou fantasma.",
    "Lime com parcimônia. Reservado a destaque positivo (aprovar, ganho, saldo).",
    "Claro é o padrão. Escuro entra na UI de produto e como contraponto.",
    "Display em caixa-alta. Anton sempre uppercase, entrelinha apertada (0.94–1).",
    "Os quadrados de moldura (chip, selo, CTA) usam o degradé roxo→azul do ecossistema."
  ]
}
